# Kodiak Configuration Example
# Copy this file to .env and configure your settings.

# =============================================================================
# LLM CONFIGURATION
# =============================================================================

# Kodiak's current MVP runtime is OpenRouter-only.
# Get a key from https://openrouter.ai/keys
KODIAK_LLM_PROVIDER=openrouter
KODIAK_OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default OpenRouter model IDs.
KODIAK_PLANNER_MODEL=anthropic/claude-3.5-haiku-20241022
KODIAK_ANALYST_MODEL=anthropic/claude-3.5-sonnet-20241022
KODIAK_LLM_MODEL=anthropic/claude-3.5-sonnet-20241022

# LLM Settings
KODIAK_LLM_TEMPERATURE=1.0
KODIAK_LLM_MAX_TOKENS=8192

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

KODIAK_DB_TYPE=sqlite

# PostgreSQL is optional for production-style deployments.
POSTGRES_SERVER=localhost
POSTGRES_USER=kodiak
POSTGRES_PASSWORD=kodiak_password
POSTGRES_DB=kodiak_db
POSTGRES_PORT=5432

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

KODIAK_DEBUG=false
KODIAK_LOG_LEVEL=INFO
KODIAK_ENABLE_SAFETY=true

# Tool settings
KODIAK_TOOL_TIMEOUT=300
KODIAK_GLOBAL_CONCURRENCY=6
KODIAK_HEAVY_TOOL_PARALLEL_LIMIT=2
KODIAK_TOOL_SCHEDULER=queue
KODIAK_TOOL_QUEUE_LIMIT=50
KODIAK_REPORT_PATH=~/.kodiak/reports

# TUI Configuration
KODIAK_TUI_COLOR_THEME=dark
KODIAK_TUI_REFRESH_RATE=10
